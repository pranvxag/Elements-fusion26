# Google Maps JavaScript API key for this Next.js app.
# For Vite apps, use VITE_GOOGLE_MAPS_API_KEY instead.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Existing app settings.
DATABASE_URL=postgresql://user:password@localhost:5432/agririsk
SESSION_SECRET=replace-with-a-long-random-secret
